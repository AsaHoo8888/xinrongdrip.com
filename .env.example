# Fill DATABASE_URL locally. Use a NEW dedicated remote database; inspect before migrating.
DATABASE_URL=
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
CRON_SECRET=
PREVIEW_SECRET=

# implicit = TLS from connection start (usually 465); starttls = required upgrade (usually 587).
SMTP_HOST=
SMTP_PORT=
SMTP_TLS_MODE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_ADDRESS=
CONTACT_NOTIFY_TO=

# Enable only behind a proxy that REPLACES x-forwarded-for.
TRUST_PROXY=false
